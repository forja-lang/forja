# ── Directorios generados / temporales ──
# El sitio vive en su propio repo (forja-lang.github.io); clonarlo acá es opcional.
/docs/
# Los diseños (PSD/PNG) viven en su propio repo (forja-lang/forja-design); no son código.
/design/
# La extensión de VS Code vive en su propio repo (forja-lang/vscode); se clona solo para empaquetarla.
/vscode/
fib_rs/
target/
test_inline_rs/
.vscode/
.cargo/
.roo/
.forja_gui_cache/
.kilo/
.opencode/
opencode.json
scratch/
dist/
temp_gui_project/
temp_gui_android_project/
ejemplos/android/
patches/
fuzz/
src/bin/fuzz_simple.rs
main_rs/
forjanzas/
forjaX/
tmp/
*.profraw
actions-runner/
plans/
/plans
frontera-modulos.generated.md

# ── Ejecutables ──
*.exe

# ── Scripts ──
*.ps1
# el instalador de Windows del release debe versionarse.
!scripts/install.ps1
# El bump de versión debe versionarse en las dos plataformas: al estar ignorado,
# la copia de Windows se desincronizó del .sh y dejó de actualizar lugares
# (README de crates, docs, scripts de instalación, plantilla Gradle).
!scripts/bump-version.ps1
fix_code_entities.py
fix_debug.py
fix_astro.py
__pycache__/
batch_commit.py
ejemplo_imports.fa
fix_await.py
reorganizar_std_pages.py
fix_astro_braces.py
fix_astro_braces

# ── Archivos de texto / resultados ──
*.txt
logo.png
forja_history.txt
test_resultados.txt
SECURITY_TESTING.md
ANALISIS_MEJORAS.md
COMPATIBILITY_BREAKING_CHANGES.md


# ── Patrones específicos (reemplazan los wildcards peligrosos *test*/*tests*) ──
# NO usar *test*/*tests*; ignoran archivos legítimos (p. ej. latest.fa, contest.rs).
# Los directorios de tests ya están cubiertos por `tests/` más arriba.
*.tmp

# ── Null (generados por el compilador) ──
$null
return$null

# ── baseline de rendimiento generada en el runner de CI ──
benches/baseline-ci.json

# ── Markdown ──
# NO ignorar *.md globalmente (se perdía documentación en subcarpetas).
# Solo se excluyen artefactos generados explícitos:
dist/*.md

# ── Licencia ──
!/LICENSE

# ── Salidas de pruebas de transpilación (cargo projects generados a mano) ──
gui_block_rs/
gui_call_rs/
gui_nuevo_sin_import_rs/
gui_old_rs/
gui_sin_import_rs/
json_solo_import_rs/
money_rs/

# ── Artefactos de herramientas ──
node_modules/
.astro/
.pi/

# ── Configuración en tiempo de ejecución ──
# `forja` crea forja.yaml en el directorio donde se ejecuta, con los defaults.
forja.yaml

# ── Editores ──
.openidea/

# Instalador: salidas de compilación del bootstrapper
installer/bootstrapper/bin/
installer/bootstrapper/obj/
*.msi
forja-setup-x64.exe
*.wixpdb

# Paquete generado por scripts/servir-demo-dom.sh (no se versiona)
demo-dom/pkg/

# Artefactos de la demo (base y configuración local)
demos/tareas-web/tareas.db
demos/tareas-web/repl_historial.txt
demos/tareas-web/forja.yaml
