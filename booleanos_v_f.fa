/// v y f — atajos de verdadero y falso
///
/// REGLA (la única que hay que recordar):
///   - Si el programa NO declara nada llamado `v` ni `f`, entonces `v` es
///     `verdadero` y `f` es `falso`.
///   - Si en CUALQUIER lugar del programa se declara una variable, constante,
///     parámetro, campo o método llamado `v` (o `f`), el atajo se apaga para
///     TODO el archivo: `v`/`f` son identificadores normales, con el mismo
///     chequeo de siempre ("variable no declarada" si no lo están).
///   - La anotación de tipo NO cambia la regla: decide el NOMBRE, no el tipo.
///
/// Correr con:  forja booleanos_v_f.fa
///
/// Este archivo NO declara `v` ni `f`, así que todo lo de abajo usa el atajo.

// ─────────────────────────────────────────────────────────────────────────────
// 1. v y f como valores
// ─────────────────────────────────────────────────────────────────────────────
escribir(v)                        // verdadero
escribir(f)                        // falso
escribir(no v)                     // falso
escribir(no f)                     // verdadero

// ─────────────────────────────────────────────────────────────────────────────
// 2. v y f en operadores lógicos
// ─────────────────────────────────────────────────────────────────────────────
escribir(v y v)                    // verdadero
escribir(v y f)                    // falso
escribir(v o f)                    // verdadero
escribir(f o f)                    // falso

// ─────────────────────────────────────────────────────────────────────────────
// 3. v y f como condición
// ─────────────────────────────────────────────────────────────────────────────
si (v) { escribir("entra al si") } sino { escribir("no entra") }   // entra al si
si (f) { escribir("entra al si") } sino { escribir("no entra") }    // no entra

// Operador ternario
escribir(v ? "si" : "no")          // si
escribir(f ? "si" : "no")          // no

// ─────────────────────────────────────────────────────────────────────────────
// 4. v y f como argumento
// ─────────────────────────────────────────────────────────────────────────────
funcion responder(activo: Booleano) -> Texto {
    si (activo) { retornar "activo" }
    retornar "inactivo"
}
escribir(responder(v))             // activo
escribir(responder(f))             // inactivo
escribir(responder(no f))          // activo

// ─────────────────────────────────────────────────────────────────────────────
// 5. v y f en coincidir
// ─────────────────────────────────────────────────────────────────────────────
funcion clasificar(x: Booleano) -> Texto {
    coincidir (x) {
        caso verdadero -> { retornar "verdadero" }
        caso falso -> { retornar "falso" }
    }
}
escribir(clasificar(v))            // verdadero
escribir(clasificar(f))            // falso

// ─────────────────────────────────────────────────────────────────────────────
// 6. v y f dentro de un arreglo o un mapa
// ─────────────────────────────────────────────────────────────────────────────
variable banderas = [v, f, no f]
escribir(banderas)                 // [verdadero,falso,verdadero]

variable opciones = {"activo": v, "borrado": f}
escribir(opciones["activo"])       // verdadero
escribir(opciones["borrado"])      // falso

// ─────────────────────────────────────────────────────────────────────────────
// 7. v y f con contratos
// ─────────────────────────────────────────────────────────────────────────────
funcion siempre_activo() -> Booleano
    asegura resultado == v
{
    retornar v
}
escribir(siempre_activo())         // verdadero

// ═════════════════════════════════════════════════════════════════════════════
// LO QUE *NO* SE PUEDE EN ESTE ARCHIVO (porque el atajo ya está activo)
// ═════════════════════════════════════════════════════════════════════════════
//
// Los bloques de abajo están comentados a propósito: si se descomenta
// cualquiera de ellos se declara `v`/`f` y el atajo se apaga EN TODO EL
// ARCHIVO, incluido todo lo de arriba. Es justamente lo que se quiere mostrar.
//
// Para probarlos, copiá el bloque en un archivo .fa aparte.

// ── 8. Variable llamada v: es una variable normal (y apaga el atajo) ────────
//
//   variable v = 1
//   escribir(v)                  // 1
//   escribir(v + 1)              // 2
//   // Y desde esa declaración, TODOS los `v` de este archivo pasan a ser la
//   // variable: el `escribir(v)` de la sección 1 imprimiría 1 (no
//   // `verdadero`), y `escribir(no v)` imprimiría `nulo` (no `falso`), porque
//   // `no` sobre un entero no es un booleano.
//
// ── 9. Variable con tipo Booleano llamada v: sigue siendo variable ─────────
//
//   variable v: Booleano = falso
//   escribir(v)                  // falso
//   // Si `v` fuera atajo, imprimiría `verdadero` y perderías el valor real.
//   // La anotación de tipo NO reactiva el atajo.
//
// ── 10. Inicializador que se autorreferencia: error ────────────────────────
//
//   variable v: Booleano = v
//   escribir(v)
//   // ● Significado — línea 1 — La variable 'v' no está declarada.
//   // Al declarar `v`, el `v` de la derecha deja de ser `verdadero`.
//   // Lo correcto es: variable v: Booleano = verdadero
//
// ── 11. Parámetro llamado v: el atajo se apaga para el programa ────────────
//
//   funcion responder(v: Booleano) -> Texto { si (v) { retornar "si" } retornar "no" }
//   escribir(responder(v))
//   // ● Significado — línea 2 — La variable 'v' no está declarada.
//   // El `v` del parámetro es un nombre declarado; el argumento `v` no es
//   // `verdadero`. Llamá con responder(verdadero) o renombrá el parámetro.
//
// ── 12. Campo o método llamado v: también apaga el atajo ───────────────────
//
//   clase C {
//       variable v: Booleano
//       constructor() { este.v = verdadero }
//   }
//   escribir(v)                  // ● La variable 'v' no está declarada.
//   // `v` es el nombre de un campo; en el programa `v` es un identificador.
//   // Se usa con este.v (o con la instancia creada), no como atajo.
//
// ── 13. Por qué el apagado es para todo el archivo ─────────────────────────
//
//   El atajo se aplica como una pasada posterior al parseo: junta los nombres
//   declarados en todo el programa y reescribe `v`/`f` sólo donde el nombre
//   NO está declarado. No hay resolución por ámbito, así que la decisión es
//   global. Es conservador a propósito: preferimos que un `v` declarado nunca
//   se convierta en `verdadero` (bug silencioso) a que el atajo funcione "a
//   veces". Si tu programa declara `v`/`f`, usá `verdadero`/`falso`.
